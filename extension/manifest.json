{
  "manifest_version": 3,
  "name": "SalonBoard 顧客一覧＋詳細エクスポート",
  "version": "1.1.0",
  "description": "SalonBoardの顧客一覧・詳細・予約履歴をCSVに保存します（ローカル完結）",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SalonBoard Export"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://salonboard.com/*"
  ]
}
